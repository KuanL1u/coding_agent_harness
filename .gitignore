# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Run traces (keep the directory, ignore contents)
runs/*
!runs/.gitkeep

# Agent workspace contents (keep the directory, ignore contents)
workspace/*
!workspace/.gitkeep

# Experience / memory store (Layer 1) — accumulated run history is local state
memory/

# Rejected-candidate audit artifacts (Layer 3). Adopted version files under
# policy/ are meant to be committed; the archive is local audit noise.
policy/archive/

# Local config overrides
config.local.yaml
.env
